    "expression": "* * * * *",
    "yandexExpression": "* * ? * * *",
    "lockTimeoutMs": 240000,
    "yandexExecutionTimeoutSeconds": 180
  },
  {
    "key": "uploads",
    "job": "uploads:pending:cleanup",
    "expression": "15 * * * *",
    "yandexExpression": "15 * ? * * *",
    "lockTimeoutMs": 900000,
    "yandexExecutionTimeoutSeconds": 840
  },
  {
    "key": "auth",
    "job": "auth:sessions:cleanup",
    "expression": "0 3 * * *",
    "yandexExpression": "0 3 ? * * *",
    "lockTimeoutMs": 240000,
    "yandexExecutionTimeoutSeconds": 180
  }
]
