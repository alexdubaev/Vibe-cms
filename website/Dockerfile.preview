FROM oven/bun:1.3.14 AS build

WORKDIR /app

COPY . .
RUN bun install --frozen-lockfile --filter @web-app-demo/website --network-concurrency=4
RUN bun run --cwd website build

FROM oven/bun:1.3.14 AS runtime

WORKDIR /app
ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=4321

COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/website/dist ./website/dist
COPY --from=build /app/website/package.json ./website/package.json

EXPOSE 4321
CMD ["bun", "website/dist/server/entry.mjs"]
