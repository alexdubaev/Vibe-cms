---
import BaseLayout from '@/layouts/BaseLayout.astro'
import SitePage from '@/cms/SitePage.astro'
import { loadPublicationSnapshot, resolvePageMetadata } from '@/cms/snapshot'

export async function getStaticPaths() {
  const snapshot = await loadPublicationSnapshot()
  if (!snapshot) return []
  return snapshot.pages
    .filter((page) => page.path !== '/')
    .map((page) => ({
      params: { slug: page.path.slice(1) },
      props: { page, snapshot },
    }))
}

const { page, snapshot } = Astro.props
const metadata = resolvePageMetadata(snapshot, page, import.meta.env.PUBLIC_WEBSITE_URL)
---

<BaseLayout
  canonicalUrl={metadata.canonicalUrl}
  description={metadata.description}
  noIndex={metadata.noIndex}
  socialImage={metadata.socialImage}
  title={metadata.title}
>
  <SitePage page={page} snapshot={snapshot} />
</BaseLayout>
