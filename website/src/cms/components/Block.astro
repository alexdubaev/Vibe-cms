---
import type { AstroComponentFactory } from 'astro/runtime/server/index.js'

import type { PublicBlock } from '../block-registry'
import { resolveBlockRenderer } from '../block-registry'
import CoreBlock from '../CoreBlock.astro'
import type { WebsitePublicationSnapshot } from '../snapshot'

interface Props {
  block: PublicBlock
  collections?: WebsitePublicationSnapshot['collections']
  media?: WebsitePublicationSnapshot['media']
  mediaBasePath?: string
  priority?: boolean
}

const props = Astro.props
const renderer = resolveBlockRenderer(props.block.type)
const ResolvedBlock = (renderer.kind === 'package' ? renderer.Component : CoreBlock) as AstroComponentFactory
---

<ResolvedBlock {...props} />
