---
import type { PublicPage } from './block-registry'
import Block from './components/Block.astro'
import type { WebsitePublicationSnapshot } from './snapshot'

interface Props {
  page: PublicPage
  media?: WebsitePublicationSnapshot['media']
  collections?: WebsitePublicationSnapshot['collections']
  mediaBasePath?: string
}

const { collections, media, mediaBasePath, page } = Astro.props
const firstHeroIndex = page.blocks.findIndex((block) => block.type === 'hero')
---

<main id="main-content">
  {page.blocks.map((block, index) => <Block
    block={block}
    collections={collections ?? []}
    media={media ?? []}
    mediaBasePath={mediaBasePath}
    priority={index === firstHeroIndex}
  />)}
</main>
