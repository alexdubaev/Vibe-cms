---
import type { PublicPage } from './block-registry'
import Block from './components/Block.astro'

interface Props {
  page: PublicPage
  mediaBasePath?: string
}

const { mediaBasePath, page } = Astro.props
---

<main id="main-content">
  {page.blocks.map((block) => <Block block={block} mediaBasePath={mediaBasePath} />)}
</main>
