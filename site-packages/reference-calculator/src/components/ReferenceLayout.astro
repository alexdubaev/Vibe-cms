---
interface Props {
  settings?: { companyName?: string }
}

const { settings } = Astro.props
const companyName = settings?.companyName ?? 'Vibe Estimate'
---

<div class="reference-shell">
  <header class="reference-header">
    <a class="reference-brand" href="/" aria-label={`${companyName}: на главную`}>
      <span aria-hidden="true" class="reference-mark">V/</span>
      <span>{companyName}</span>
    </a>
    <span class="reference-note">Точно по вашим параметрам</span>
  </header>

  <slot />

  <footer class="reference-footer">
    <span>{companyName}</span>
    <span>Расчёт без отправки данных</span>
  </footer>
</div>

<style>
  :global(body) {
    margin: 0;
    background: #f0eee8;
    color: #16241d;
    font-family: Inter, ui-sans-serif, system-ui, sans-serif;
  }

  .reference-shell {
    --ink: #16241d;
    --paper: #f0eee8;
    --signal: #f06b3a;
    min-height: 100vh;
    background:
      linear-gradient(90deg, rgba(22, 36, 29, 0.06) 1px, transparent 1px) 0 0 / 48px 48px,
      var(--paper);
  }

  .reference-header,
  .reference-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1rem clamp(1rem, 4vw, 4rem);
    border-color: color-mix(in srgb, var(--ink) 24%, transparent);
    font-size: 0.75rem;
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .reference-header { border-bottom: 1px solid; }
  .reference-footer { border-top: 1px solid; }

  .reference-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    color: inherit;
    text-decoration: none;
  }

  .reference-brand:focus-visible {
    outline: 3px solid var(--signal);
    outline-offset: 4px;
  }

  .reference-mark {
    display: grid;
    width: 2.25rem;
    aspect-ratio: 1;
    place-items: center;
    border-radius: 50%;
    background: var(--ink);
    color: var(--paper);
    letter-spacing: -0.08em;
  }

  .reference-note { text-align: right; }

  @media (max-width: 38rem) {
    .reference-note { display: none; }
    .reference-footer { align-items: flex-start; flex-direction: column; }
  }
</style>
