---
import type { EstimateCalculatorData } from '../contract'

interface Props {
  block: {
    id: string
    type: 'estimateCalculator'
    data: EstimateCalculatorData
  }
}

const { block } = Astro.props
const { data } = block
---

<section
  class="estimate"
  data-estimate-calculator
  data-minimum-price={data.minimumPrice}
  data-unit-price={data.unitPrice}
  data-cms-block-id={block.id}
  id="estimate"
>
  <div class="estimate-copy">
    <p class="estimate-kicker">// онлайн-расчёт</p>
    <h2>{data.title}</h2>
    <p class="estimate-description">{data.description}</p>
    <dl class="estimate-facts">
      <div>
        <dt>Ставка</dt>
        <dd>{new Intl.NumberFormat('ru-RU').format(data.unitPrice)} ₽ / м²</dd>
      </div>
      <div>
        <dt>Минимум</dt>
        <dd>{new Intl.NumberFormat('ru-RU').format(data.minimumPrice)} ₽</dd>
      </div>
    </dl>
  </div>

  <form class="estimate-panel" onsubmit="return false">
    <label class="estimate-label">
      <span>Площадь помещения, м²</span>
      <input
        data-estimate-area
        inputmode="decimal"
        max={data.maximumArea}
        min={data.minimumArea}
        name="area"
        required
        step="any"
        type="number"
        value={data.minimumArea}
      />
    </label>

    <div class="estimate-range" aria-hidden="true">
      <span>{data.minimumArea} м²</span>
      <span>{data.maximumArea} м²</span>
    </div>

    <div class="estimate-result">
      <span>Предварительно</span>
      <output aria-live="polite" data-estimate-total name="total" role="status">—</output>
    </div>
    <p class="estimate-help">Точная смета зависит от состава и сложности работ.</p>
  </form>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-estimate-calculator]').forEach((calculator) => {
    const input = calculator.querySelector<HTMLInputElement>('[data-estimate-area]')
    const output = calculator.querySelector<HTMLOutputElement>('[data-estimate-total]')
    if (!input || !output) return

    const unitPrice = Number(calculator.dataset.unitPrice)
    const minimumPrice = Number(calculator.dataset.minimumPrice)

    const updateEstimate = () => {
      const area = Number(input.value)
      const estimate = Math.max(minimumPrice, area * unitPrice)
      output.value = new Intl.NumberFormat('ru-RU').format(estimate) + ' ₽'
    }

    input.addEventListener('input', updateEstimate)
    updateEstimate()
  })
</script>

<style>
  .estimate {
    display: grid;
    min-height: min(760px, calc(100vh - 9rem));
    grid-template-columns: minmax(0, 1.1fr) minmax(20rem, 0.9fr);
    gap: clamp(2rem, 7vw, 8rem);
    align-items: center;
    padding: clamp(3rem, 8vw, 8rem) clamp(1rem, 7vw, 7rem);
  }

  .estimate-copy { max-width: 48rem; }

  .estimate-kicker {
    margin: 0 0 1.5rem;
    color: #c54b24;
    font: 700 0.75rem/1.2 ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  h2 {
    max-width: 12ch;
    margin: 0;
    font-size: clamp(3rem, 7vw, 7.5rem);
    font-weight: 520;
    letter-spacing: -0.07em;
    line-height: 0.92;
  }

  .estimate-description {
    max-width: 44rem;
    margin: 2rem 0 0;
    font-size: clamp(1.05rem, 1.7vw, 1.4rem);
    line-height: 1.55;
  }

  .estimate-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem 4rem;
    margin: clamp(2.5rem, 6vw, 5rem) 0 0;
  }

  .estimate-facts div { display: grid; gap: 0.35rem; }

  .estimate-facts dt,
  .estimate-result > span {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .estimate-facts dd { margin: 0; font-size: 1.1rem; font-weight: 650; }

  .estimate-panel {
    padding: clamp(1.5rem, 4vw, 3rem);
    border: 1px solid #16241d;
    border-radius: 1.75rem;
    background: #16241d;
    box-shadow: 0.75rem 0.75rem 0 #f06b3a;
    color: #f0eee8;
  }

  .estimate-label { display: grid; gap: 1rem; font-weight: 650; }

  input {
    width: 100%;
    box-sizing: border-box;
    border: 0;
    border-bottom: 2px solid currentColor;
    border-radius: 0;
    padding: 0.35rem 0;
    background: transparent;
    color: inherit;
    font: 500 clamp(3rem, 6vw, 5rem)/1 ui-monospace, SFMono-Regular, Menlo, monospace;
  }

  input:focus-visible { outline: 3px solid #f06b3a; outline-offset: 6px; }

  .estimate-range {
    display: flex;
    justify-content: space-between;
    margin-top: 0.75rem;
    color: #b9c5be;
    font-size: 0.75rem;
  }

  .estimate-result {
    display: grid;
    gap: 0.75rem;
    margin-top: clamp(3rem, 7vw, 5rem);
  }

  output {
    color: #ff8459;
    font-size: clamp(2.2rem, 5vw, 4.25rem);
    font-weight: 600;
    letter-spacing: -0.06em;
    line-height: 1;
  }

  .estimate-help { margin: 1.5rem 0 0; color: #b9c5be; font-size: 0.8rem; line-height: 1.5; }

  @media (max-width: 52rem) {
    .estimate {
      grid-template-columns: 1fr;
      min-height: auto;
      padding-block: 4rem;
    }
    .estimate-panel { max-width: 38rem; }
  }
</style>
