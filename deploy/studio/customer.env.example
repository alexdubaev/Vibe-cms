# Public, deliberately fake example values. Production validation intentionally rejects every
# credential below. Copy to <customer>.env outside version control and replace every credential.
INSTALLATION_SLUG=client-auto

ADMIN_ORIGIN=https://admin.auto.example
API_ORIGIN=https://api.auto.example
PREVIEW_ORIGIN=https://preview.auto.example
CMS_WEBSITE_PUBLIC_ORIGIN=https://www.auto.example
ADMIN_BIND_PORT=18101
API_BIND_PORT=18102
PREVIEW_BIND_PORT=18103

# Both roles target one customer-only database. The owner URL is for explicit migrations only and is not passed to containers.
DATABASE_URL=postgresql://vibe_client_auto_app:9kR4mP7xT2vN8qL6sD3f@postgres-studio:5432/vibe_client_auto?schema=public
DATABASE_ADMIN_URL=postgresql://vibe_client_auto_owner:6zH2cB9wQ5nM8rT4yK7p@postgres-studio:5432/vibe_client_auto?schema=public
JWT_SECRET=98d7c261adf503b84e96721cf0a536d898d7c261adf503b84e96721cf0a536d8

CMS_SITE_PACKAGE_ID=auto-service
CMS_BUILDER_HMAC_SECRET=e472911f0a58bc63d4e472911f0a58bc63d4e472911f0a58bc63d4e472911f0
CMS_WEBSITE_PROMOTION_TOKEN=a950e6732c84df71b6a950e6732c84df71b6a950e6732c84df71b6a950e673
CMS_BUILDER_QUEUE_URL=https://message-queue.auto.example/client-auto
CMS_BUILDER_YMQ_ENDPOINT=https://message-queue.auto.example
CMS_BUILDER_YMQ_REGION=ru-central1
# Backend producer identity: grant SendMessage only on this customer queue.
CMS_BUILDER_YMQ_ACCESS_KEY_ID=queue-client-auto-key
CMS_BUILDER_YMQ_SECRET_ACCESS_KEY=d5319f8a2ce7406bd5319f8a2ce7406bd5319f8a
# Private builder consumer identity: grant ReceiveMessage/DeleteMessage only on the same queue.
CMS_BUILDER_YMQ_CONSUMER_ACCESS_KEY_ID=queue-client-auto-consumer-key
CMS_BUILDER_YMQ_CONSUMER_SECRET_ACCESS_KEY=0c84e2a751b93d6f0c84e2a751b93d6f0c84e2a7

# Private working media credentials: access must be limited to this exact bucket.
PRIVATE_STORAGE_ENDPOINT=https://s3.media.auto.example
PRIVATE_STORAGE_REGION=ru-central1
PRIVATE_STORAGE_BUCKET=client-auto-private-media
PRIVATE_STORAGE_ACCESS_KEY_ID=media-client-auto-key
PRIVATE_STORAGE_SECRET_ACCESS_KEY=f03ab84d97e2615cf03ab84d97e2615cf03ab84d
PRIVATE_STORAGE_S3_SCOPE=bucket:client-auto-private-media/*
PRIVATE_STORAGE_FORCE_PATH_STYLE=false

# Public destination credentials: write/promotion access must be limited to this different bucket.
CMS_WEBSITE_STORAGE_ENDPOINT=https://s3.publish.auto.example
CMS_WEBSITE_STORAGE_REGION=ru-central1
CMS_WEBSITE_STORAGE_BUCKET=client-auto-public-site
CMS_WEBSITE_STORAGE_ACCESS_KEY_ID=publish-client-auto-key
CMS_WEBSITE_STORAGE_SECRET_ACCESS_KEY=15c8e470a29df63115c8e470a29df63115c8e470
CMS_WEBSITE_STORAGE_S3_SCOPE=bucket:client-auto-public-site/*
CMS_WEBSITE_STORAGE_FORCE_PATH_STYLE=false
CMS_WEBSITE_SELECTOR_URL=https://promotion.auto.example/select
CMS_WEBSITE_PURGE_URL=https://promotion.auto.example/purge

# These two resources already exist on the VDS and are shared across isolated Compose projects.
STUDIO_POSTGRES_NETWORK=vibe-cms-studio-postgres
STUDIO_BUILD_LOCK_VOLUME=vibe-cms-studio-build-lock
CMS_ASTRO_BUILD_LOCK_FILE=/var/lock/vibe-cms/astro-build.lock

# Immutable images. Repositories may carry a readable tag, but every runtime reference is pinned by digest.
BACKEND_IMAGE=registry.auto.example/vibe/backend
BACKEND_IMAGE_DIGEST=sha256:1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a
WEBAPP_IMAGE=registry.auto.example/vibe/webapp
WEBAPP_IMAGE_DIGEST=sha256:2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b
PREVIEW_IMAGE=registry.auto.example/vibe/preview
PREVIEW_IMAGE_DIGEST=sha256:3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c
BUILDER_IMAGE=registry.auto.example/vibe/builder
BUILDER_IMAGE_DIGEST=sha256:4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d
